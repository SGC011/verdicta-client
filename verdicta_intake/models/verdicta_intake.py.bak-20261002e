    # ------------------------------------------------------------------
    @api.model_create_multi
    def create(self, vals_list):
        records = super().create(vals_list)
        for rec in records:
            if not rec.reference or rec.reference == _("New"):
                rec.reference = rec._next_reference()
        return records

    @api.model
    def _next_reference(self):
        year = fields.Date.today().year
        prefix = "VIN-%d-" % year
        last = self.sudo().search(
            [("reference", "=like", prefix + "%")],
            order="reference desc", limit=1,
        )
        seq = int(last.reference[len(prefix):]) + 1 if last else 1
        return "%s%04d" % (prefix, seq)

    @api.depends("answer_ids.question_id")
    def _compute_answered_question_ids(self):
        for intake in self:
            intake.answered_question_ids = intake.answer_ids.mapped("question_id")

    def _compute_open_question_ids(self):
        """Work out what is still unanswered and how far along the client is.

        Note the two different denominators, which matters because a question
        disappears from the form as soon as it is answered:
          * open_question_ids drives the form, so it is relative to what is
            still on offer;
          * progress_pct is relative to every live question, so the bar does
            not jump back to 100% every time a question closes.
        """
        Question = self.env["verdicta.question"].sudo()
        open_qs = Question.open_input_questions()
        total = Question.search_count([("state", "!=", "retired")])
        for intake in self:
            answered = intake.answer_ids.mapped("question_id")
            intake.open_question_ids = open_qs - answered
            intake.progress_pct = (
                100 if not total else int(round(len(answered) * 100.0 / total))
            )

    @api.depends("answer_ids.question_id")
    def _compute_outstanding_required(self):
        Question = self.env["verdicta.question"].sudo()
        required_open = Question.open_input_questions().filtered("required")
        for intake in self:
            answered = intake.answer_ids.mapped("question_id")
            intake.outstanding_required = len(required_open - answered)

    def _refresh_outstanding_everywhere(self):
        """Refresh the stored outstanding count on every open intake.

        Resolving a question is a global change, so other clients' counts shift
        too. Previously this recomputed across every intake and wrote every row
        on every submission, which made two concurrent POSTs of the same form
        contend for the same question rows and fail with a serialization error.

        The recompute is now scoped to intakes that are still open, and it
        writes only the stored counter. Closed intakes are skipped because
        their count can no longer change.
        """
        self = self.sudo()
        if not self:
            return
        self.env["verdicta.question"].invalidate_model(
            ["state"], flush=True
        )
        open_intakes = self.search([("state", "in", ("draft", "submitted"))])
        if not open_intakes:
            return
        open_intakes._compute_outstanding_required()

    def _retry_on_conflict(self, func, *args, **kwargs):
        """Run func, retrying if PostgreSQL rolls the transaction back.

        A double submit is harmless - the answers are written by question id,
        so a second pass overwrites rather than duplicates. The only real
        failure mode is two transactions touching the same rows at once.
        """
        import psycopg2

        attempts = 3
        for n in range(attempts):
            try:
                return func(*args, **kwargs)
            except psycopg2.errors.SerializationFailure:
                if n == attempts - 1:
                    raise
                # The transaction is dead. Roll back to a clean state, drop
                # cached values and try the whole submission again.
                self.env.cr.rollback()
                self.env.invalidate_all()

    # ------------------------------------------------------------------
    # public URL
    # ------------------------------------------------------------------
    def _public_url(self):
        self.ensure_one()
        base = (
            self.env["ir.config_parameter"]
            .sudo()
            .get_param("web.base.url", "")
        ).rstrip("/")
        if not base or base.startswith("http://localhost"):
            base = "https://verdicta.sgctech.ai"
        return "%s/onboarding/%s" % (base, self.access_code)

    # ------------------------------------------------------------------
    # capture
    # ------------------------------------------------------------------
    def rate_limited(self):
        """True when this submission has been posted too often recently."""
        self.ensure_one()
        from datetime import timedelta
        cutoff = fields.Datetime.now() - timedelta(hours=1)
        recent = self.env["verdicta.attempt"].sudo().search_count([
            ("ip", "=", self.last_submit_ip or ""),
            ("route", "=", "form"),
            ("success", "=", True),
            ("create_date", ">=", cutoff),
        ])
        return recent >= MAX_SUBMITS_PER_HOUR

    def pending_answer_changes(self, post):
        """Questions whose posted answer differs from what is on file.

        Read-only, so the controller can find out whether a save changes
        anything *before* writing or sending anything. Mirrors the rules in
        ``_apply_submission``: a blank or unticked box is not a change, and
        a value equal to the stored one is not a change either.
        """
        self.ensure_one()
        Answer = self.env["verdicta.answer"]
        pending = self.env["verdicta.question"]
        for question in self.env["verdicta.question"].open_input_questions():
            field_name = question.input_name()
            if field_name not in post:
                continue
            text, joined = Answer._render_value(question, post.get(field_name))
            if not text:
                continue
            existing = self.answer_ids.filtered(
                lambda a, q=question: a.question_id == q)[:1]
            if existing:
                if (existing.value == text
                        and (existing.values_list or "") == (joined or "")
                        and (existing.known_display or "")
                        == (question.known_display() or "")):
                    continue
            pending |= question
        return pending

    def apply_submission(self, post, ip=None, signed=False):
        """Capture a submission, retrying cleanly on serialization conflict."""
        return self._retry_on_conflict(self._apply_submission, post, ip=ip)

    def _apply_submission(self, post, ip=None):
        """Record a client submission.

        Only questions that are currently ``open`` are considered, so a
        question that was retired or auto-closed while the page sat open in
        the client's browser cannot be written back.

        :return: (saved_answers, closed_questions, errors, stored_count)
        """
        self.ensure_one()
        Question = self.env["verdicta.question"].sudo()
        Answer = self.env["verdicta.answer"].sudo()
        posted = posted or {}

        if self.rate_limited():
            return [], self.env["verdicta.question"], [
                _("Too many submissions from this connection. Please try "
                  "again later.")
            ]

        open_by_name = {}
        for question in Question.open_input_questions():
            open_by_name[question.input_name()] = question

        submit_no = self.submit_count + 1
        now = fields.Datetime.now()
        values, closed, errors, stored = [], self.env["verdicta.question"], [], 0

        for field_name, question in open_by_name.items():
            if field_name not in posted:
                continue
            raw = posted.get(field_name)
            text, joined = Answer._render_value(question, raw)
            if not text:
                # Blank or un-ticked: leave the question open.
                continue

            existing = Answer.search([
                ("intake_id", "=", self.id),
                ("question_id", "=", question.id),
            ], limit=1)
            vals = {
                "question_label": question.label,
                "question_text": question.name,
                "section": question.section,
                "known_display": question.known_display() or "",
                "value": text,
                "values_list": joined,
                "answered_at": now,
                "submit_no": submit_no,
                "submit_ip": ip or "",
            }
            if existing:
                # Re-saving the same answer is not a change: leave the
                # snapshot, its timestamp and the save counter alone so a
                # click on Save with nothing edited changes nothing.
                if (existing.value == text
                        and (existing.values_list or "") == (joined or "")
                        and (existing.known_display or "")
                        == (vals["known_display"] or "")):
                    continue
                existing.write(vals)
                stored += 1
            else:
                values.append(dict(vals, intake_id=self.id, question_id=question.id))

            if not question.auto_close and question.state == "open":
                closed |= question

        if values:
            Answer.create(values)
            stored += len(values)

        # Validate required questions *after* closing, so a question the
        # client has just answered never counts against them.
        answered_qids = self.answer_ids.mapped("question_id")
        still_required = Question.open_input_questions().filtered(
            lambda q: q.required and q not in answered_qids
        )
        for question in still_required:
            errors.append(
                _("%(label)s is still required.") % {"label": question.label}
            )

        if closed:
            closed.write({"state": "resolved"})
            self._refresh_outstanding_everywhere()

        # Nothing new on the form: leave the record exactly as it is. No
        # save counter, no timestamp, no state change - the click is a
        # no-op and the caller sends nothing.
        if not (stored or closed):
            return values, closed, errors, 0

        remaining = Question.open_input_questions() - answered_qids
        complete = not remaining
        # A submission only closes once every required question is answered
        # *and* it carries a signature. A signature posted with this save
        # counts, because it is stamped a moment later.
        can_close = complete and (self.is_signed or signed)
        if self.state == "draft":
            new_state = "submitted"
        elif can_close:
            new_state = "closed"
        else:
            new_state = self.state

        if complete and not can_close:
            errors.append(
                _("Everything is answered. Please sign the submission so it "
                  "can be closed.")
            )

        self.write({
            "state": new_state,
            "submitted_at": self.submitted_at or now,
            "last_submitted_at": now,
            "submit_count": submit_no,
            "last_submit_ip": ip or self.last_submit_ip,
        })

        return values, closed, errors, stored

