    signed_answer_count = fields.Integer(
        string="Answers at Signing",
        help="How many answers the digest covers.",
    )
    is_signed = fields.Boolean(string="Signed", compute="_compute_is_signed")

    @api.depends("signature", "signed_by", "client_signer_name")
    def _compute_is_signed(self):
        for intake in self:
            intake.is_signed = bool(
                intake.signature or intake.signed_by or intake.client_signer_name
            )

    # ------------------------------------------------------------------
    # PDF
    # ------------------------------------------------------------------
    def action_generate_pdf(self):
        """Render (or re-render) the A4 PDF and return the attachment."""
        self.ensure_one()
        # Resolve the ir.actions.report record, not the QWeb view: env.ref on
        # the template xmlid returns an ir.ui.view, which has no report_name.
        report = self.env.ref("verdicta_intake.report_verdicta_intake")
        # Odoo 19 silently downgrades report rendering to HTML whenever
        # test_enable is on unless this flag is set, which would store HTML
        # under a .pdf name. Ask for the real thing explicitly.
        content, ext = self.env["ir.actions.report"].with_context(
            force_report_rendering=True,
        )._render_qweb_pdf(report.report_name, [self.id])
        is_pdf = ext == "pdf"
        suffix = "pdf" if is_pdf else "html"
        mimetype = "application/pdf" if is_pdf else "text/html"
        filename = "%s.%s" % (self.reference or self.id, suffix)
        old = self.pdf_attachment_id
        attachment = self.env["ir.attachment"].sudo().create({
            "name": filename,
            "raw": content,
            "res_model": self._name,
            "res_id": self.id,
            "mimetype": mimetype,
        })
        if old:
            old.unlink()
        self.sudo().write({"pdf_attachment_id": attachment.id})
        return attachment

    # ------------------------------------------------------------------
    # Signature
    # ------------------------------------------------------------------
    def _answers_digest(self):
        """SHA-256 over the answers as they stand right now.

        Recomputing this later must give the same value, so any edit made
        after signing is detectable.
        """
        self.ensure_one()
        import hashlib

        digest = hashlib.sha256()
        for answer in self.answer_ids.sorted(lambda a: a.id):
            digest.update(("%s|%s|%s\n" % (
                answer.question_id.id,
                answer.value or "",
                answer.known_display or "",
            )).encode("utf-8"))
        return digest.hexdigest()

    def signature_data_uri(self):
        """The stored signature as a data URI, for the form and the report."""
        self.ensure_one()
        if not self.signature:
            return False
        from odoo.tools.image import image_data_uri

        return image_data_uri(self.signature)

    def _signature_url(self):
        """Absolute URL of the stored signature, for the report.

        wkhtmltopdf does not embed data: URI images reliably, and the
        renderer can reach the site over HTTP (it already loads the logo
        that way), so the stamp points at a real URL instead. The route is
        behind the intake access code, the same secret that opens the form.
        """
        self.ensure_one()
        if not self.signature:
            return False
        return "%s/onboarding/%s/signature.png" % (
            self.get_base_url(), self.access_code)

    def signing_seal_status(self):
        """Live check that the answers still match the signed seal.

        Empty when unsigned. If an answer is edited after signing the seal
        no longer matches and the record says so, which is the whole point
        of sealing the answers with the signature.
        """
        self.ensure_one()
        if not self.signing_digest:
            return ""
        if self.signing_digest == self._answers_digest():
            return "Matches the answers on file"
        return "CHANGED AFTER SIGNING - the answers no longer match the seal"

    def signing_seal_display(self):
        """One-line seal printed on the record and in the desk email."""
        self.ensure_one()
        if not self.signing_digest:
            return False
        return "%s answers, sealed at signing, SHA-256 %s" % (
            self.signed_answer_count or 0, self.signing_digest[:32])

    @api.model
    def _decode_signature_png(self, raw):
        """Validate a canvas data URL and return the PNG bytes.

        Returns ``b""`` when nothing usable was sent, so a signature is
        never half-applied.
        """
        if not raw:
            return b""
        import base64

        value = raw.strip()
        if value.startswith("data:"):
            _, _, value = value.partition(",")
        try:
            data = base64.b64decode(value, validate=True)
        except Exception:  # noqa: BLE001
            raise UserError(_("The signature could not be read. Please sign again."))
        if not data.startswith(b"\x89PNG\r\n\x1a\n"):
            raise UserError(_("The signature has to be a drawn signature. "
                              "Please sign in the box."))
        if len(data) > 400 * 1024:
            raise UserError(_("That signature image is too large. Please sign again."))
        return data

    @api.model
    def _clean_signature_svg(self, raw):
        """Reduce client-supplied path data to drawing characters only.

        The value is rendered straight into the report, and it arrives from
        the public form, so anything that is not a path command, a number or
        a separator is dropped.
        """
        if not raw:
            return False
        import re

        cleaned = re.sub(r"[^MLCQSTAZmlcqstaz0-9,.\- ]", "", str(raw))
        return cleaned[:20000] or False

    def signature_needs_update(self, name, role=None, signature_png=b"",
                               signature_svg=""):
        """True when the signature posted on the form differs from the file.

        Only data the client actually re-entered is compared, so reopening
        the form and saving untouched never counts as a new signature.
        """
        self.ensure_one()
        if not self.is_signed:
            return True
        name = (name or "").strip()
        if name and name != (self.client_signer_name or ""):
            return True
        role = (role or "").strip()
        if role and role != (self.client_signer_role or ""):
            return True
        svg = self._clean_signature_svg(signature_svg)
        if svg and svg != (self.signature_svg or ""):
            return True
        if signature_png and signature_png != (self.signature or b""):
            return True
        return False

    def action_sign_submission(self, name, role=None, signature_png=b"",
                              signature_svg="", ip=None, authority=False):
        """Stamp this submission with the signer's signature.

        The signature is bound to the answers through ``signing_digest``:
        edit an answer afterwards and the digest stops matching, so the
        record shows it was altered after signing.
        """
        self.ensure_one()
        name = (name or "").strip()
        if not name:
            raise UserError(_("Please give the full name of the person signing."))
        if not authority:
            raise UserError(_("The signer has to confirm they are authorised "
                              "to submit for the practice."))
        values = {
            "client_signer_name": name,
            "client_signer_role": (role or "").strip(),
            "client_sign_date": fields.Date.context_today(self),
            "signed_by": name,
            "signed_on": fields.Datetime.now(),
            "signature_ip": ip or "",
            "authority_confirmed": True,
        }
        if signature_png:
            values["signature"] = signature_png
        clean_svg = self._clean_signature_svg(signature_svg)
        if clean_svg:
            values["signature_svg"] = clean_svg
        self.sudo().write(values)
        self.sudo().write({
            "signing_digest": self._answers_digest(),
            "signed_answer_count": len(self.answer_ids),
        })
        _logger.info(
            "verdicta_intake: %s signed by %s (%s answers, digest %s)",
            self.reference, name, self.signed_answer_count,
            (self.signing_digest or "")[:12],
        )
        return True

    def action_clear_signature(self):
        """Drop the signature so the record can be signed again."""
        self.ensure_one()
        self.sudo().write({
            "signature": False,
            "signature_svg": False,
            "signed_by": False,
            "signed_on": False,
            "signature_ip": False,
            "client_signer_name": False,
            "client_signer_role": False,
            "client_sign_date": False,
            "authority_confirmed": False,
            "signing_digest": False,
            "signed_answer_count": 0,
        })
        return True

    # ------------------------------------------------------------------
    # PDF helpers
    # ------------------------------------------------------------------
    #: Bundled with the module so it renders for the public and for wkhtmltopdf
    #: without needing read access to the company partner record.
    LOGO_STATIC = "/verdicta_intake/static/src/img/verdicta_logo.png"

    def _logo_url(self):
        self.ensure_one()
        # Absolute URL: wkhtmltopdf resolves relative sources against the
        # temp-file location, so a bare path silently drops the logo.
        return "%s%s" % (self.get_base_url(), self.LOGO_STATIC)

    def _company_address(self):
        self.ensure_one()
        company = self.company_id
        return ", ".join(
            p for p in [company.street, company.city, company.country_id.name] if p
        )

    def section_answer_rows(self):
        """``(section_label, answer, is_first_of_section)`` rows for the PDF.

        The report renders each section heading as a spanning row of the
        first question table, so a heading can never be stranded at the
        bottom of a page (the PDF engine only honours page-break-inside
        on tables).
        """
        self.ensure_one()
        rows = []
        for label, records in self._answers_by_section():
            for index, _answer in enumerate(records):
                rows.append((label, _answer, index == 0))
        return rows

    def _answers_by_section(self):
        """Answers grouped by section label, in the form's section order.

        Only sections that actually have answers appear, so the PDF does not
        carry empty headings for questions the client never reached.
        """
        self.ensure_one()
        section_labels = dict(
            self.env["verdicta.question"]._fields["section"].selection
        )
        order = [key for key, _label in self.env["verdicta.question"]._fields[
            "section"].selection]
        buckets = {}
        for answer in self.answer_ids:
            key = answer.section or ""
            buckets.setdefault(key, self.env["verdicta.answer"])
            buckets[key] |= answer
        out = []
        for key in order:
            records = buckets.get(key)
            if records:
                out.append((section_labels.get(key, key), records))
        # anything with an unknown section still gets printed, at the end
        for key, records in buckets.items():
            if key not in order:
                out.append((section_labels.get(key, key or "Other"), records))
        return out

    # ------------------------------------------------------------------
    # mail
    # ------------------------------------------------------------------
    def _notify_values(self, pdf=None):
        self.ensure_one()
        return {
            "intake_url": self._public_url(),
            "reference": self.reference,
            "practice": self.practice_name or "",
            "contact": self.contact_name or "",
            "outstanding": self.outstanding_required,
            "progress": self.progress_pct,
        }

    def _send(self, xmlid, email_values_extra=None, force_send=True):
        self.ensure_one()
        template = self.env.ref(xmlid, raise_if_not_found=False)
        if not template:
            _logger.warning("verdicta_intake: missing mail template %s", xmlid)
            return self.env["mail.mail"]
        email_values = dict(email_values_extra or {})
        # force_send is a send_mail() argument in Odoo 19, not an email_values
        # key: passing it in the dict raises "Invalid field 'force_send'".
        return template.with_context(**self._notify_values()).send_mail(
            self.id, email_values=email_values, force_send=force_send,
        )

    def action_send_invite(self):
        for intake in self:
            intake._send("verdicta_intake.mail_template_invite")
        return True

    def action_send_acknowledgement(self):
        for intake in self:
            pdf = intake.pdf_attachment_id or intake.action_generate_pdf()
            intake._send(
                "verdicta_intake.mail_template_ack",
                {"attachment_ids": [(6, 0, [pdf.id])]},
            )
        return True

    def action_notify_sgc(self):
        """Email the completed submission to the SGC accounting desk."""
        self.ensure_one()
        pdf = self.pdf_attachment_id or self.action_generate_pdf()
        attachments = [(6, 0, [pdf.id])]
        csv = self._answers_csv()
        if csv:
            attachment = self.env["ir.attachment"].sudo().create({
                "name": "%s-answers.csv" % self.reference,
                "raw": csv.encode("utf-8-sig"),
                "res_model": self._name,
                "res_id": self.id,
                "mimetype": "text/csv",
            })
            attachments.append((4, attachment.id))
        self._send(
            "verdicta_intake.mail_template_submission",
            {"attachment_ids": attachments},
        )
        self.sudo().write({"notified": True})
        return True

    def _answers_csv(self):
        """Flat CSV of the answers, for the accounting side."""
        import csv
        import io
        buf = io.StringIO()
        writer = csv.writer(buf)
        writer.writerow([
            "Reference", "Submitted", "Section", "Question", "Answer",
        ])
        section_labels = dict(self.env["verdicta.question"]._fields[
            "section"].selection)
        for answer in self.answer_ids.sorted(lambda a: (a.section, a.id)):
            writer.writerow([
                self.reference or "",
                (self.last_submitted_at or "").strftime("%Y-%m-%d %H:%M")
                if self.last_submitted_at else "",
                section_labels.get(answer.section, answer.section or ""),
                answer.question_label or "",
                answer.value or "",
            ])
        return buf.getvalue()

    # ------------------------------------------------------------------
    # actions
    # ------------------------------------------------------------------
    def action_reopen(self):
        """Mint a fresh access code and re-invite."""
        for intake in self:
            intake.sudo().write({
                "access_code": _code(),
                "notified": False,
            })
            intake._send("verdicta_intake.mail_template_invite")
        return True

    def action_reset_answers(self):
        for intake in self:
            intake.answer_ids.unlink()
            intake.sudo().write({
                "state": "draft",
                "submit_count": 0,
                "submitted_at": False,
                "last_submitted_at": False,
                "notified": False,
            })
        return True

    def action_close(self):
        self.write({"state": "closed"})

    def action_reopen_record(self):
        self.write({"state": "submitted"})

    def _check_access_code(self, code):
        self.ensure_one()
        return bool(code) and secrets.compare_digest(
            (code or "").strip().upper(), self.access_code,
        )
