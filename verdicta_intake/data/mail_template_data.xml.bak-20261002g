<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ invite ============================ -->
    <record id="mail_template_invite" model="mail.template">
        <field name="name">Verdicta Intake: client invite</field>
        <field name="model_id" ref="model_verdicta_intake"/>
        <field name="use_default_to">False</field>
        <field name="subject">{{ object.practice_name or object.contact_name or 'Verdicta client' }} — your private intake link ({{ object.reference }})</field>
        <field name="email_from">{{ object.company_id.email or 'info@sgctech.ai' }}</field>
        <field name="email_to">{{ object.contact_email }}</field>
        <field name="lang">{{ object.contact_email and 'en_US' or 'en_US' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1B2733;line-height:1.6;">
                <p>Dear <t t-out="object.contact_name or 'Sir/Madam'"/>,</p>

                <p>
                    Thank you for your patience while we set up the accounting
                    records for
                    <b><t t-out="object.practice_name or 'your practice'"/></b>.
                </p>

                <p>
                    Your source ledgers have already been reconciled and loaded.
                    A short form is now open for the handful of items we could
                    not settle from the documents alone.
                </p>

                <p style="margin:18px 0;">
                    <a t-attf-href="{{ intake_url }}"
                       style="background:#1F3A5F;color:#fff;text-decoration:none;
                              padding:11px 22px;border-radius:4px;font-weight:bold;
                              display:inline-block;">Open my intake form</a>
                </p>

                <p style="font-size:12px;color:#5A6B7F;">
                    If the button does not work, copy this address into your
                    browser:<br/>
                    <span t-out="intake_url"/>
                </p>

                <p>
                    <b>Keep this link private.</b> It is the only thing that
                    opens your form, so please do not forward it. If you think
                    it has been seen by someone else, reply to this email and
                    we will issue a new one.
                </p>

                <p>
                    You can save and come back as often as you like. Every
                    question you answer disappears from the form, so it only
                    ever gets shorter — you will never be asked the same
                    thing twice.
                </p>

                <p style="font-size:12px;color:#5A6B7F;margin-top:22px;">
                    Your reference is <b t-out="object.reference"/>.<br/>
                    Verdicta is a client of SGC TECH AI. This message is about
                    accounting records and does not create a retainer.
                </p>
            </div>
        </field>
    </record>

    <!-- ========================== acknowledge ========================== -->
    <record id="mail_template_ack" model="mail.template">
        <field name="name">Verdicta Intake: answers saved</field>
        <field name="model_id" ref="model_verdicta_intake"/>
        <field name="use_default_to">False</field>
        <field name="subject">Your answers are saved — {{ object.reference }}</field>
        <field name="email_from">{{ object.company_id.email or 'info@sgctech.ai' }}</field>
        <field name="email_to">{{ object.contact_email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1B2733;line-height:1.6;">
                <p>Dear <t t-out="object.contact_name or 'Sir/Madam'"/>,</p>

                <p>
                    <b>Thank you — we have your answers.</b> They are saved in
                    your accounting file and a PDF copy is attached for your
                    records.
                </p>

                <p t-if="object.outstanding_required">
                    We still need
                    <b><t t-out="object.outstanding_required"/></b>
                    required item(s). Your form is still open at the link below
                    and now shows only what is left:
                </p>
                <p t-else="">
                    Nothing required is outstanding. If we think of anything
                    else, we will email you a fresh form.
                </p>

                <p style="margin:18px 0;">
                    <a t-attf-href="{{ intake_url }}"
                       style="background:#1F3A5F;color:#fff;text-decoration:none;
                              padding:11px 22px;border-radius:4px;font-weight:bold;
                              display:inline-block;">Reopen my form</a>
                </p>

                <p style="font-size:12px;color:#5A6B7F;">
                    Reference <b t-out="object.reference"/> ·
                    <t t-out="intake_url"/>
                </p>

                <p t-if="object.is_signed">
Your answers are signed by <b><span t-out="object.client_signer_name"/></b><span t-if="object.client_signer_role">, <span t-out="object.client_signer_role"/></span>, on <span t-out="object.client_sign_date"/>.
Keep this email: the signature and the seal below are your proof of what was submitted.
Seal: <span t-out="object.signing_seal_display()"/>.
</p>
<p style="font-size:12px;color:#5A6B7F;margin-top:22px;">
                    If anything you have entered is wrong, please reopen the
                    form and correct it — do not edit the PDF.
                </p>
            </div>
        </field>
    </record>

    <!-- ======================== notify the desk ======================== -->
    <record id="mail_template_submission" model="mail.template">
        <field name="name">Verdicta Intake: submission received</field>
        <field name="model_id" ref="model_verdicta_intake"/>
        <field name="use_default_to">False</field>
        <field name="subject">[Verdicta intake] {{ object.reference }} — {{ object.practice_name or object.contact_name or 'client' }} ({{ object.outstanding_required }} outstanding)</field>
        <field name="email_from">{{ object.company_id.email or 'info@sgctech.ai' }}</field>
        <field name="email_to">{{ 'info@sgctech.ai' }}</field>
        <field name="email_cc">{{ 'bran@sgctech.ai' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#1B2733;line-height:1.6;">
                <p><b>Client intake submitted</b></p>

                <table cellpadding="5" style="border-collapse:collapse;font-size:12.5px;">
                    <tr>
                        <td style="background:#F2F6FB;border:1px solid #C7D2E0;"><b>Reference</b></td>
                        <td style="border:1px solid #C7D2E0;" t-out="object.reference"/>
                    </tr>
                    <tr>
                        <td style="background:#F2F6FB;border:1px solid #C7D2E0;"><b>Client</b></td>
                        <td style="border:1px solid #C7D2E0;" t-out="object.practice_name or object.contact_name or '-'"/>
                    </tr>
                    <tr>
                        <td style="background:#F2F6FB;border:1px solid #C7D2E0;"><b>Contact</b></td>
                        <td style="border:1px solid #C7D2E0;">
                            <t t-out="object.contact_name or '-'"/>
                            <t t-if="object.contact_email"> &lt;<t t-out="object.contact_email"/>&gt;</t>
                        </td>
                    </tr>
                    <tr>
                        <td style="background:#F2F6FB;border:1px solid #C7D2E0;"><b>Answers saved</b></td>
                        <td style="border:1px solid #C7D2E0;">
                            <t t-out="object.answer_ids and len(object.answer_ids) or 0"/>
                            question(s) · save #<t t-out="object.submit_count"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="background:#F2F6FB;border:1px solid #C7D2E0;"><b>Outstanding</b></td>
                        <td style="border:1px solid #C7D2E0;">
                            <b t-out="object.outstanding_required"/> required item(s)
                        </td>
                    </tr>
                    <tr>
                        <td style="background:#F2F6FB;border:1px solid #C7D2E0;"><b>From IP</b></td>
                        <td style="border:1px solid #C7D2E0;" t-out="object.last_submit_ip or '-'"/>
                    </tr>
                </table>

                <p>
                    Attached: the A4 PDF of the client's answers, plus a CSV of
                    the same data for the accounting file.
                </p>

                <p t-if="object.is_signed">
<b>Digitally signed:</b> <span t-out="object.client_signer_name"/><span t-if="object.client_signer_role"> (<span t-out="object.client_signer_role"/>)</span> on <span t-out="object.client_sign_date"/>.
Seal: <span t-out="object.signing_seal_display()"/> &#8212; <span t-out="object.signing_seal_status()"/>.
</p>
<p style="font-size:12px;color:#5A6B7F;">
                    Review it in Odoo under
                    <b>Accounting → Verdicta Intake → Submissions</b>.<br/>
                    Do not reply to the client from this notification.
                </p>
            </div>
        </field>
    </record>

</odoo>
