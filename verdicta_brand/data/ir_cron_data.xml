<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kept inactive. The post_init_hook does the seeding at install; this
         exists so an operator can re-run it by hand from Technical > Scheduled
         Actions without reinstalling. -->
    <record id="ir_cron_seed_letterhead" model="ir.cron">
        <field name="name">Verdicta Brand: re-apply letterhead and logo</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_seed_letterhead()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
